\frametitle{Problem 1 Matlab Code}
%\rule{\textwidth}{1pt}
%\begin{block}{MATLAB}
\begin{lstlisting}[language={matlab},
                   numberstyle=\tiny\menlo,
                   basicstyle=\small\menlo]
function r=bisect(a,b,accurate)
p=(a+b)/2;
error=b-a;
n=0;
while (error>accurate)
    n=n+1;
    if fun(p)==0
      break;
          else if fun(a)*fun(p)<0
            b=p;
        else
            a=p;
              end
        p=(a+b)/2;
        error=(b-a)/2^2;
    end
        r=p;
end end
\end{lstlisting}
%\end{block}
